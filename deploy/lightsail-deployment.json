{
  "serviceName": "mooltrace",
  "containers": {
    "api": {
      "image": ":mooltrace.api.13",
      "environment": {
        "MOOLTRACE_PUBLIC_DEMO": "1",
        "MOOLTRACE_PUBLIC_LIVE": "1",
        "MOOLTRACE_PUBLIC_LIVE_CONCURRENCY": "1",
        "MOOLTRACE_PUBLIC_LIVE_TIMEOUT_S": "120",
        "MOOLTRACE_OPENALEX_RPS": "3",
        "MOOLTRACE_SEED": "1",
        "MOOLTRACE_DB": "/data/demo.db",
        "MOOLTRACE_API_HOST": "0.0.0.0",
        "MOOLTRACE_API_PORT": "4317",
        "MOOLTRACE_MAILTO": "siddhant.m.vishnu@gmail.com",
        "MOOLTRACE_CORS_ORIGINS": "https://mooltrace.h9g8gwz2b559t.ap-south-1.cs.amazonlightsail.com"
      },
      "ports": {
        "4317": "HTTP"
      }
    },
    "web": {
      "image": ":mooltrace.web.14",
      "environment": {
        "MOOLTRACE_API_ORIGIN": "http://localhost:4317",
        "NODE_OPTIONS": "--max-old-space-size=384"
      },
      "ports": {
        "4318": "HTTP"
      }
    }
  },
  "publicEndpoint": {
    "containerName": "web",
    "containerPort": 4318,
    "healthCheck": {
      "healthyThreshold": 2,
      "unhealthyThreshold": 10,
      "timeoutSeconds": 5,
      "intervalSeconds": 10,
      "path": "/",
      "successCodes": "200-499"
    }
  }
}
